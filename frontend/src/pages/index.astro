---
import MainLayout from "../layouts/MainLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../lib/sanity";
import { homePostsQuery, featuredPostsQuery } from "../lib/queries";
import { imageUrl } from "../lib/images";

const posts = sanityConfigured
  ? await sanityFetch<any[]>(homePostsQuery).catch(() => [])
  : [];
const featuredPosts = sanityConfigured
  ? await sanityFetch<any[]>(featuredPostsQuery).catch(() => [])
  : [];
const featured = (featuredPosts.length ? featuredPosts : posts).slice(0, 3);
---
<MainLayout title="Love Catalogue | Love, Dating & Relationships">
  <section class="featured-section">
    <div class="mx-auto max-w-6xl px-5 pt-9 pb-12">
      <div class="section-heading">
        <span class="eyebrow">Love Catalogue</span>
        <h1>Stories for every side of love</h1>
      </div>

      {featured.length ? (
        <div class="featured-grid">
          {featured.map((post, index) => {
            const cover = imageUrl(post.mainImage, 1100);
            return (
              <article class:list={["featured-card", index === 0 && "featured-card-large"]}>
                <a href={`/${post.slug}/`} class="featured-card-image" style={cover ? `background-image: url("${cover}")` : undefined}>
                  <span class="featured-image-shade"></span>
                  <span class="featured-white-panel">
                    {post.category?.title && <span class="featured-category">{post.category.title}</span>}
                    <span class="featured-title">{post.title}</span>
                    <span class="featured-read-more">+ READ MORE</span>
                  </span>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="empty-featured">
          <h2>Your featured stories will appear here.</h2>
          <p>Mark published articles as featured in Sanity to display them in this section.</p>
        </div>
      )}
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-12 lg:grid-cols-[minmax(0,1fr)_280px]">
    <section>
      <div class="mb-7 flex items-end justify-between">
        <div>
          <p class="eyebrow">Fresh from the journal</p>
          <h2 class="mt-2 text-3xl font-bold">Latest articles</h2>
        </div>
      </div>

      {posts.length ? (
        <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2">
          {posts.map((post) => <ArticleCard post={post} />)}
        </div>
      ) : (
        <div class="border border-dashed border-[var(--line)] p-8">
          <h3 class="text-xl font-bold">Your publication is ready for content.</h3>
          <p class="mt-2 max-w-xl text-sm leading-6 text-[var(--muted)]">
            Publish your first article in Sanity. Published posts will appear here automatically after the next build.
          </p>
        </div>
      )}
    </section>

    <aside class="space-y-8">
      <section class="border-t-2 border-[var(--ink)] pt-4">
        <h2 class="text-xl font-bold">Explore topics</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/category/relationships/">Relationships</a></li>
          <li><a href="/category/dating/">Dating</a></li>
          <li><a href="/category/love-messages/">Love Messages</a></li>
        </ul>
      </section>
    </aside>
  </div>
</MainLayout>

<style>
  .featured-section { background: #fff; }
  .section-heading { margin-bottom: 1.5rem; text-align: center; }
  .section-heading h1 { margin-top: .45rem; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; letter-spacing: -.035em; }
  .eyebrow { color: var(--rose); font-size: .7rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; align-items: stretch; }
  .featured-card { min-width: 0; }
  .featured-card-image { position: relative; display: flex; min-height: 350px; height: 100%; align-items: flex-end; justify-content: center; overflow: hidden; background-color: #eee5e1; background-position: center; background-size: cover; padding: 1.1rem; }
  .featured-card-large .featured-card-image { min-height: 410px; }
  .featured-image-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(30,20,20,.02) 35%, rgba(30,20,20,.28) 100%); transition: background .25s ease; }
  .featured-card-image:hover .featured-image-shade { background: rgba(30,20,20,.18); }
  .featured-white-panel { position: relative; z-index: 1; display: flex; width: min(100%, 390px); flex-direction: column; align-items: flex-start; background: rgba(255,255,255,.96); padding: 1.15rem 1.25rem; text-align: left; }
  .featured-category { color: var(--rose); font-size: .66rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .featured-title { margin-top: .45rem; font-size: clamp(1.1rem, 1.5vw, 1.45rem); font-weight: 700; line-height: 1.25; }
  .featured-read-more { margin-top: .8rem; font-size: .65rem; font-weight: 700; letter-spacing: .1em; }
  .empty-featured { border: 1px dashed var(--line); padding: 3rem 1.5rem; text-align: center; }
  .empty-featured h2 { font-size: 1.35rem; font-weight: 700; }
  .empty-featured p { margin-top: .5rem; color: var(--muted); font-size: .9rem; }
  @media (max-width: 760px) {
    .featured-grid { grid-template-columns: 1fr; }
    .featured-card-image, .featured-card-large .featured-card-image { min-height: 330px; }
    .featured-white-panel { width: min(100%, 420px); }
  }
</style>
