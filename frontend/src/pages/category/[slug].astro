---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../../lib/sanity";
import { allCategoriesQuery, categoryBySlugQuery } from "../../lib/queries";
import { imageUrl } from "../../lib/images";

const siteUrl = "https://love-catalogue.pages.dev";

export async function getStaticPaths() {
  if (!sanityConfigured) return [];
  const categories = await sanityFetch<any[]>(allCategoriesQuery).catch(() => []);
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const category = slug
  ? await sanityFetch<any>(categoryBySlugQuery, { slug }).catch(() => null)
  : null;

if (!category) return Astro.redirect("/404");

const posts = category.posts || [];
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const categoryTitle = category.title || "Category";
const pageDescription = category.description || `Read the latest ${categoryTitle.toLowerCase()} articles on Love Catalogue.`;
const featuredImage = featuredPost?.mainImage ? imageUrl(featuredPost.mainImage, 1200) : "";
const featuredDate = featuredPost?.publishedAt
  ? new Date(featuredPost.publishedAt).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })
  : "";
---
<MainLayout title={`${categoryTitle} | Love Catalogue`} description={pageDescription} canonicalUrl={`${siteUrl}/category/${slug}/`}>
  <div class="category-page">
    <header class="category-hero">
      <div class="category-hero-inner">
        <nav class="category-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span>{categoryTitle}</span>
        </nav>
        <p class="category-eyebrow">Browse by topic</p>
        <h1>{categoryTitle}</h1>
        {category.description && <p class="category-description">{category.description}</p>}
        <p class="category-count">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
      </div>
    </header>

    <div class="category-content">
      {featuredPost ? (
        <>
          <section class="category-featured" aria-labelledby="category-featured-title">
            <a class="category-featured-image" href={`/${featuredPost.slug}/`}>
              {featuredImage
                ? <img src={featuredImage} alt={featuredPost.mainImage?.alt || featuredPost.title} fetchpriority="high" />
                : <span aria-hidden="true" />}
            </a>
            <div class="category-featured-copy">
              <p class="category-section-label">Latest article</p>
              <h2 id="category-featured-title"><a href={`/${featuredPost.slug}/`}>{featuredPost.title}</a></h2>
              {featuredPost.excerpt && <p class="category-featured-excerpt">{featuredPost.excerpt}</p>}
              {featuredDate && <time datetime={featuredPost.publishedAt}>{featuredDate}</time>}
              <a class="category-read-more" href={`/${featuredPost.slug}/`}>Read article <span aria-hidden="true">→</span></a>
            </div>
          </section>

          {remainingPosts.length > 0 && (
            <section class="category-articles" aria-labelledby="category-articles-title">
              <div class="category-section-heading">
                <p class="category-section-label">More to read</p>
                <h2 id="category-articles-title">Latest {categoryTitle} Articles</h2>
              </div>
              <div class="category-article-grid">
                {remainingPosts.map((post: any) => <ArticleCard post={post} />)}
              </div>
            </section>
          )}
        </>
      ) : (
        <div class="category-empty">
          <h2>Articles are on the way</h2>
          <p>There are no published articles in this category yet. Browse the latest stories on Love Catalogue.</p>
          <a href="/">Explore latest articles</a>
        </div>
      )}
    </div>
  </div>
</MainLayout>
