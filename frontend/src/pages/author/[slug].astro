---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../../lib/sanity";
import { authorBySlugQuery } from "../../lib/queries";

export async function getStaticPaths() {
  if (!sanityConfigured) return [];
  const authors = await sanityFetch<{ slug: string }[]>(`*[_type == "author" && defined(slug.current)]{"slug": slug.current}`).catch(() => []);
  return authors.map(({ slug }) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const author = slug ? await sanityFetch<any>(authorBySlugQuery, { slug }).catch(() => null) : null;
---
<MainLayout title={(author?.name || "Author") + " | Love Catalogue"} description={author?.bio || "Articles by this Love Catalogue author."}>
  <section class="mx-auto max-w-6xl px-5 py-12">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--rose)]">Author</p>
    <h1 class="mt-3 text-4xl font-bold">{author?.name || "Author"}</h1>
    {author?.bio && <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">{author.bio}</p>}
    <h2 class="mb-7 mt-12 text-2xl font-bold">Articles by {author?.name || "this author"}</h2>
    {author?.posts?.length ? <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{author.posts.map((post: any) => <ArticleCard post={post} />)}</div> : <p class="text-[var(--muted)]">No published articles by this author yet.</p>}
  </section>
</MainLayout>
