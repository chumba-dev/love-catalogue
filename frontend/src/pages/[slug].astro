---
import MainLayout from "../layouts/MainLayout.astro";
import { sanityConfigured, sanityFetch } from "../lib/sanity";
import { allPostSlugsQuery, postBySlugQuery } from "../lib/queries";
import { imageUrl } from "../lib/images";
import { toHTML } from "@portabletext/to-html";

export async function getStaticPaths() {
  if (!sanityConfigured) return [];
  const slugs = await sanityFetch<{ slug: string }[]>(allPostSlugsQuery).catch(() => []);
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = slug && sanityConfigured
  ? await sanityFetch<any>(postBySlugQuery, { slug }).catch(() => null)
  : null;

if (!post) return Astro.redirect("/404");
const cover = imageUrl(post.mainImage, 1400);
const bodyHtml = post.body ? toHTML(post.body) : "";
const pageTitle = post.seoTitle || post.title;
const pageDescription = post.seoDescription || post.excerpt || "";
---
<MainLayout title={`${pageTitle} | Love Catalogue`} description={pageDescription}>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <a href={post.category ? `/category/${post.category.slug}/` : "/"} class="text-xs font-semibold uppercase tracking-[.15em] text-[var(--rose)]">
      {post.category?.title || "Love Catalogue"}
    </a>
    <h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl">{post.title}</h1>
    {post.excerpt && <p class="mt-5 text-xl leading-8 text-[var(--muted)]">{post.excerpt}</p>}
    <div class="mt-5 text-sm text-[var(--muted)]">
      {post.author?.name || "Love Catalogue"} · {new Date(post.publishedAt).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}
    </div>
    {cover && <img src={cover} alt={post.imageAlt || post.title} class="mt-8 aspect-[16/9] w-full object-cover" />}
    <div class="prose-content mt-9" set:html={bodyHtml} />
    {post.tags?.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2">
        {post.tags.map((tag: any) => <a class="bg-[#f6eeeb] px-3 py-1 text-xs" href={`/tag/${tag.slug}/`}>{tag.title}</a>)}
      </div>
    )}
  </article>
</MainLayout>
