---
import MainLayout from "../layouts/MainLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../lib/sanity";
import { homePostsQuery, featuredPostsQuery } from "../lib/queries";

const posts = sanityConfigured
  ? await sanityFetch<any[]>(homePostsQuery).catch(() => [])
  : [];
const featured = sanityConfigured
  ? await sanityFetch<any[]>(featuredPostsQuery).catch(() => [])
  : [];
---
<MainLayout title="Love Catalogue | Love, Dating & Relationships">
  <section class="bg-[#f8efed]">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--rose)]">Love · Dating · Relationships</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">Thoughtful words for every kind of love.</h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-[var(--muted)]">Advice, inspiration, and meaningful messages for stronger connections.</p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-12 lg:grid-cols-[minmax(0,1fr)_280px]">
    <section>
      <div class="mb-7 flex items-end justify-between">
        <div>
          <p class="text-xs uppercase tracking-[.18em] text-[var(--rose)]">From the journal</p>
          <h2 class="mt-2 text-3xl font-bold">Latest articles</h2>
        </div>
      </div>

      {posts.length ? (
        <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2">
          {posts.map((post) => <ArticleCard post={post} />)}
        </div>
      ) : (
        <div class="border border-dashed border-[var(--line)] p-8">
          <h3 class="text-xl font-bold">Your publication is ready for content.</h3>
          <p class="mt-2 max-w-xl text-sm leading-6 text-[var(--muted)]">
            Configure the Sanity project, open the Studio, and publish your first article. Published posts will appear here automatically on the next build.
          </p>
        </div>
      )}
    </section>

    <aside class="space-y-8">
      <section class="border-t-2 border-[var(--ink)] pt-4">
        <h2 class="text-xl font-bold">Featured reads</h2>
        {featured.length ? (
          <ul class="mt-4 space-y-4">
            {featured.map((post) => (
              <li class="border-b border-[var(--line)] pb-4">
                <a class="font-semibold leading-snug" href={`/${post.slug}/`}>{post.title}</a>
              </li>
            ))}
          </ul>
        ) : <p class="mt-3 text-sm text-[var(--muted)]">Featured articles will appear here.</p>}
      </section>
      <section class="border-t-2 border-[var(--ink)] pt-4">
        <h2 class="text-xl font-bold">Explore topics</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/category/relationships/">Relationships</a></li>
          <li><a href="/category/dating/">Dating</a></li>
          <li><a href="/category/love-messages/">Love Messages</a></li>
        </ul>
      </section>
    </aside>
  </div>
</MainLayout>
