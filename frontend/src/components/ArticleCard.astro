---
import { imageUrl } from "../lib/images";
const { post } = Astro.props;
const href = `/${post.slug}/`;
const cover = imageUrl(post.mainImage, 720);
---
<article class="group">
  <a href={href} class="block overflow-hidden bg-[#f5efec]">
    {cover ? (
      <img src={cover} alt={post.mainImage?.alt || post.title} loading="lazy"
        class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
    ) : (
      <div class="aspect-[16/10] w-full bg-gradient-to-br from-[#f7e9e8] to-[#eee3df]"></div>
    )}
  </a>
  {post.category && <p class="mt-4 text-xs font-semibold uppercase tracking-[.15em] text-[var(--rose)]">{post.category.title}</p>}
  <h2 class="mt-2 text-xl font-bold leading-snug"><a href={href}>{post.title}</a></h2>
  {post.excerpt && <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{post.excerpt}</p>}
  <p class="mt-3 text-xs text-[var(--muted)]">
    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" }) : ""}
  </p>
</article>
