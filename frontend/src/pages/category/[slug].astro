---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../../lib/sanity";
import { allCategoriesQuery, categoryBySlugQuery } from "../../lib/queries";

export async function getStaticPaths() {
  if (!sanityConfigured) return [];
  const categories = await sanityFetch<any[]>(allCategoriesQuery).catch(() => []);
  return categories.map((category) => ({ params: { slug: category.slug } }));
}
const { slug } = Astro.params;
const category = slug ? await sanityFetch<any>(categoryBySlugQuery, { slug }).catch(() => null) : null;
---
<MainLayout title={(category?.title || "Category") + " | Love Catalogue"} description={category?.description || "Browse articles on Love Catalogue."}>
  <section class="bg-[#f8efed]">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--rose)]">Browse by topic</p>
      <h1 class="mt-3 text-4xl font-bold md:text-5xl">{category?.title || "Category"}</h1>
      {category?.description && <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">{category.description}</p>}
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-12">
    {category?.posts?.length ? <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{category.posts.map((post: any) => <ArticleCard post={post} />)}</div> : <p class="text-[var(--muted)]">No published articles in this category yet.</p>}
  </section>
</MainLayout>
