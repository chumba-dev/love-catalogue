---
import "../styles/global.css";
const {
  title = "Love Catalogue | Love, Relationships & Romance",
  description = "Thoughtful reads about love, relationships, dating and romance.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://love-catalogue.pages.dev").toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Love Catalogue" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <link rel="preconnect" href="https://cdn.sanity.io" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand-row">
        <a href="/" class="site-brand" aria-label="Love Catalogue home">
          <span class="site-brand-name">Love Catalogue</span>
          <span class="site-brand-tagline">Love · Relationship · Romance</span>
        </a>
      </div>
      <nav aria-label="Main navigation" class="site-nav">
        <a href="/">Home</a>
        <a href="/category/relationships/">Relationships</a>
        <a href="/category/dating/">Dating</a>
        <a href="/category/love-messages/">Love Messages</a>
        <a href="/about/">About</a>
        <a href="/search/" class="nav-search">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
          <span>Search</span>
        </a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="mt-16 border-t border-[var(--line)] bg-white">
      <div class="mx-auto max-w-6xl px-5 py-10 text-sm text-[var(--muted)]">
        <p>Love Catalogue. Thoughtful reads about love, relationships and romance.</p>
        <div class="mt-3 flex flex-wrap gap-4">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/search/">Search</a>
        </div>
      </div>
    </footer>
  </body>
</html>
