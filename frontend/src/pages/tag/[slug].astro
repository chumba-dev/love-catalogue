---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { sanityConfigured, sanityFetch } from "../../lib/sanity";
import { tagBySlugQuery } from "../../lib/queries";

export async function getStaticPaths() {
  if (!sanityConfigured) return [];
  const tags = await sanityFetch<{ slug: string }[]>(`*[_type == "tag" && defined(slug.current)]{"slug": slug.current}`).catch(() => []);
  return tags.map(({ slug }) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const tag = slug ? await sanityFetch<any>(tagBySlugQuery, { slug }).catch(() => null) : null;
---
<MainLayout title={(tag?.title || "Tag") + " | Love Catalogue"} description={"Articles tagged " + (tag?.title || "this topic") + "."}>
  <section class="mx-auto max-w-6xl px-5 py-12">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--rose)]">Topic</p>
    <h1 class="mt-3 text-4xl font-bold">{tag?.title || "Tag"}</h1>
    <h2 class="mb-7 mt-12 text-2xl font-bold">Related articles</h2>
    {tag?.posts?.length ? <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{tag.posts.map((post: any) => <ArticleCard post={post} />)}</div> : <p class="text-[var(--muted)]">No published articles use this tag yet.</p>}
  </section>
</MainLayout>
