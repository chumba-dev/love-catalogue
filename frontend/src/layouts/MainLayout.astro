---
import "../styles/global.css";
const { title = "Love Catalogue | Love, Relationships & Romance", description = "Thoughtful reads about love, relationships, dating and romance." } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://love-catalogue.pages.dev").toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" /><link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:site_name" content="Love Catalogue" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><title>{title}</title>
<link rel="preconnect" href="https://cdn.sanity.io" />
</head>
<body>
<header class="site-header">
  <div class="site-brand-row"><a href="/" class="site-brand" aria-label="Love Catalogue home">
    <span class="site-brand-name">Love Catalogue</span><span class="site-brand-tagline">Love · Relationship · Romance</span>
  </a></div>
  <nav aria-label="Main navigation" class="site-nav">
    <a href="/">Home</a><a href="/category/relationships/">Relationships</a><a href="/category/dating/">Dating</a>
    <a href="/category/love-messages/">Love Messages</a><a href="/about/">About</a>
    <a href="/search/" class="nav-search" aria-label="Search articles">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><span>Search</span>
    </a>
  </nav>
</header>
<main><slot /></main>
<footer class="site-footer"><div class="site-footer-inner">
<p>Love Catalogue. Thoughtful reads about love, relationships and romance.</p>
<div class="site-footer-links"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/search/">Search</a></div>
</div></footer>
</body>
</html>
<style>
.site-header{background:#fff;border-bottom:1px solid var(--line)}
.site-brand-row{display:flex;justify-content:center;padding:1.35rem 1rem 1.05rem;text-align:center}
.site-brand{display:flex;flex-direction:column;align-items:center;gap:.25rem;color:var(--ink)}
.site-brand-name{font-size:clamp(1.8rem,3vw,2.45rem);font-weight:700;letter-spacing:-.045em;line-height:1.1}
.site-brand-tagline{color:var(--muted);font-family:Arial,sans-serif;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase}
.site-nav{display:flex;min-height:48px;align-items:center;justify-content:center;flex-wrap:wrap;gap:.25rem 2rem;border-top:1px solid #f2ece9;padding:.6rem 1rem;font-family:Arial,sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.025em}
.site-nav a{color:var(--ink);transition:color .2s ease}.site-nav a:hover{color:var(--rose)}
.site-nav .nav-search{display:inline-flex;align-items:center;gap:.4rem;margin-left:.25rem}
.site-footer{margin-top:4rem;border-top:1px solid var(--line);background:#fff}
.site-footer-inner{max-width:1200px;margin:0 auto;padding:2.5rem 1.25rem;color:var(--muted);font-size:.85rem}
.site-footer-links{display:flex;flex-wrap:wrap;gap:1rem;margin-top:.8rem}
@media(max-width:640px){.site-brand-row{padding-top:1rem}.site-nav{gap:.65rem 1rem;padding:.8rem .7rem;font-size:.72rem}.site-nav .nav-search{margin-left:0}}
</style>
